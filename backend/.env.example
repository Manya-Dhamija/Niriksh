# Niriksh backend configuration
# ---------------------------------------------------------------
# V1 ships with cached, source-attributed reference data for 5
# demo sites so the app runs with zero external API keys.
# The variables below are for WIRING UP LIVE DATA SOURCES in a
# future iteration (see README "Moving beyond the demo cache").

# App
NIRIKSH_ENV=development
NIRIKSH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Live data providers (not called in V1 demo mode) -----------
# NASA POWER (solar irradiance / climate) - no key required, but
# needs outbound network access to power.larc.nasa.gov
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/climatology/point

# Global Solar Atlas API (irradiance validation)
GLOBAL_SOLAR_ATLAS_BASE_URL=https://api.globalsolaratlas.info

# OpenStreetMap Overpass (roads, land use, substations)
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter

# Copernicus / OpenTopography (DEM tiles for elevation & slope)
OPENTOPOGRAPHY_API_KEY=
OPENTOPOGRAPHY_BASE_URL=https://portal.opentopography.org/API/globaldem

# Sentinel Hub (Sentinel-2 land cover / NDVI)
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# Feature flag: when true, backend will attempt live fetches for
# non-demo (custom polygon) sites and fall back to interpolation
# from cached reference sites if the network call fails.
NIRIKSH_ENABLE_LIVE_FETCH=false
